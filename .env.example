# =============================================================================
# .env.example — committed template for environment configuration.
#
# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` and all `.env.*` files are gitignored. This file is the only one that
# is committed, and it must never contain real secrets.
#
# Rules:
#   1. Every environment variable the application reads MUST be listed here,
#      with a placeholder value and a short description.
#   2. Use obvious placeholders (changeme, localhost, example.test) — never
#      real credentials, tokens, keys, or personal data.
#   3. When a variable is added or renamed, update this file in the same change
#      and note it in the task's wrap-up.
# =============================================================================

# Runtime environment. Allowed values: development | staging | production.
# Missing or unknown values must fail closed to production-safe defaults.
APP_ENV=development

# Public HTTP port the app shell listens on. Example placeholder only.
PORT=3000

# Host address the Compose port binds to. Default 127.0.0.1 (loopback only).
# Tailscale example: BIND_ADDR=100.x.y.z PORT=3100
# WARNING: 0.0.0.0 exposes the app on every interface — use only behind
# explicit firewall/TLS setup.
BIND_ADDR=127.0.0.1

# Local data directory for the future embedded store. Placeholder path only.
DATA_DIR=./data

# In-container schedule toggle for ingestion.
# Allowed values: true | false.
#   true  (default for `docker compose up`): the worker imports immediately on
#         boot, then keeps refreshing on the scheduler intervals.
#   false: the worker still runs ONE import on boot (so first start populates
#         data), then idles without scheduling further refreshes.
SCHEDULE_ENABLED=true

# Boot import gate for the worker. Allowed values: true | false.
#   true  (default): the worker runs its initial import cycle on boot.
#   false: the worker skips the initial cycle entirely, logs worker-idle, and
#         parks (still holding the scheduler lease). Use on a seeded named
#         volume so the deployment serves immediately with zero import
#         contention against the web server.
INGEST_ON_START=true

# Per-view entry cap for materialized Change Radar checkpoint lists.
# Allowed values: integer in [1, 10000].
# Views retain the observed top-N per list (boundedTopN is stored in the
# manifest and surfaced by replay responses); the eligible cohort count is
# still recorded, but lists never imply completeness.
CHECKPOINT_TOP_N=500

# CVE List V5 git clone timeout in milliseconds. The first clone downloads a
# large repository (gigabytes); expect several minutes on first boot, faster
# afterwards. Default 3600000 (1 hour); raise on slow links.
CVE_GIT_TIMEOUT_MS=3600000

# CVE List V5 clone depth. Default 1 (shallow `--depth 1` for a practical
# first boot); 0 means full history. Shallow checkouts that cannot diff
# against the previously imported SHA fall back to full reconciliation.
CVE_CLONE_DEPTH=1

# Node runtime mode. `production` is the safe default for Compose; the dev
# compose file sets `development` explicitly.
NODE_ENV=production

# Maximum accepted size of a single CVE record file, in bytes. Default
# 16777216 (16 MiB). Larger files are quarantined rather than crashing the
# import; the quarantine ceiling is max(50, 0.1% of scanned records).
CVE_MAX_RECORD_BYTES=16777216
