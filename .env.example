# =============================================================================
# .env.example — committed template for environment configuration.
#
# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` and all `.env.*` files are gitignored. This file is the only one that
# is committed, and it must never contain real secrets.
#
# Rules:
#   1. Every environment variable the application reads MUST be listed here,
#      with a placeholder value and a short description.
#   2. Use obvious placeholders (changeme, localhost, example.test) — never
#      real credentials, tokens, keys, or personal data.
#   3. When a variable is added or renamed, update this file in the same change
#      and note it in the task's wrap-up.
# =============================================================================

# REQUIRED. Runtime environment. Allowed values: development | staging |
# production. Missing or unknown values must fail closed to
# production-safe defaults.
APP_ENV=development

# REQUIRED. Public HTTP port the app shell listens on. Example placeholder only.
PORT=3000

# Host address the Compose port binds to. Default 127.0.0.1 (loopback only).
# Tailscale example: BIND_ADDR=100.x.y.z PORT=3100
# WARNING: 0.0.0.0 exposes the app on every interface — use only behind
# explicit firewall/TLS setup.
BIND_ADDR=127.0.0.1

# Public base URL used for sitemap.xml, canonical links, and social cards.
# Optional: leave blank or unset for private deployments (loopback fallback).
# Set it on any public deploy, including serverless ones without a custom
# domain — e.g. Cloud Run's automatic https://<service>-<hash>-<region>.a.run.app
# Example: SITE_URL=https://cve.example.com
SITE_URL=

# REQUIRED. Local data directory for the SQLite database and the persistent
# CVE checkout cache.
DATA_DIR=./data

# REQUIRED. In-container schedule toggle for ingestion.
# Allowed values: true | false.
#   true  (default for `docker compose up`): the worker imports immediately on
#         boot, then keeps refreshing on the scheduler intervals.
#   false: the worker still runs ONE import on boot (so first start populates
#         data), then idles without scheduling further refreshes.
SCHEDULE_ENABLED=true

# Display cap for the four priority list views. Default 100; valid 1-1000.
# Intended for QA/scale checks, not normal operation.
PRIORITY_PAGE_LIMIT=100

# Boot import gate for the worker. Allowed values: true | false.
#   true  (default): the worker runs its initial import cycle on boot.
#   false: the worker skips the initial cycle entirely, logs worker-idle, and
#         parks (still holding the scheduler lease). Use on a seeded named
#         volume so the deployment serves immediately with zero import
#         contention against the web server.
INGEST_ON_START=true

# Per-view entry cap for materialized Change Radar checkpoint lists.
# Allowed values: integer in [1, 10000].
# Views retain the observed top-N per list (boundedTopN is stored in the
# manifest and surfaced by replay responses); the eligible cohort count is
# still recorded, but lists never imply completeness.
CHECKPOINT_TOP_N=500

# CVE List V5 git clone timeout in milliseconds. The first clone downloads a
# large repository (gigabytes); expect several minutes on first boot, faster
# afterwards. Default 3600000 (1 hour); raise on slow links.
CVE_GIT_TIMEOUT_MS=3600000

# CVE List V5 clone depth. Default 1 (shallow `--depth 1` for a practical
# first boot); 0 means full history. Shallow checkouts that cannot diff
# against the previously imported SHA fall back to full reconciliation.
CVE_CLONE_DEPTH=1

# Optional CVE source override. Leave blank to use the official CVE List V5
# repository at `main`. Overrides exist for controlled mirrors/tests.
CVE_REPO_URL=
CVE_REVISION=

# Persistent CVE checkout cache. The worker keeps one stable working tree at
# <DATA_DIR>/cve-repo (override the path with CVE_REPO_DIR): first run clones
# shallow there, later runs fetch incrementally instead of re-cloning.
# Expected disk: ~5-6 GB shallow. The cache is never deleted automatically.
CVE_REPO_DIR=
CVE_REPO_CACHE_RESET=false

# EPSS history retention, in whole UTC days counted back from the accepted
# score date. EPSS adds one row per scored CVE per day (~400k rows, ~40 MB with
# indexes after the 008 slimming), so the window is what bounds growth:
# 45 days ≈ 18M rows ≈ 1.8 GB, 90 days ≈ 3.6 GB. The default matches the
# 45-point per-record history the API returns, so nothing stored is unreachable
# and nothing returned is missing. Range 30-3650.
EPSS_RETENTION_DAYS=45

# SSVC enrichment (CISA Vulnrichment). The worker clones a ~380 MB checkout on
# first run, then fetches incrementally; only rows for KEV-listed CVEs are
# imported. Optional: defaults to <DATA_DIR>/vulnrichment-repo.
SSVC_REPO_DIR=

# Node runtime mode. `production` is the safe default for Compose; the dev
# compose file sets `development` explicitly.
NODE_ENV=production

# Maximum accepted size of a single CVE record file, in bytes. Default
# 16777216 (16 MiB). Larger files are quarantined rather than crashing the
# import; the quarantine ceiling is max(50, 0.1% of scanned records).
CVE_MAX_RECORD_BYTES=16777216

# One-off aggregate-cache refresh (no import cycle). Allowed values: true | false.
#   true: `node dist/worker.mjs` recomputes the precomputed aggregate cache
#         (migration 002 `aggregate_cache`) from the current volume and exits.
#         Run once after stack upgrades on a live volume instead of waiting for
#         the next import cycle:
#           REFRESH_AGGREGATES_ONCE=true node dist/worker.mjs
#         (inside Compose the shipped bundle lives next to the entrypoint:
#         docker compose exec app env REFRESH_AGGREGATES_ONCE=true
#         node worker.mjs). The worker otherwise refreshes automatically
#         after every successful import cycle and on boot when the cache is empty.
#   false (default): normal worker boot behavior.
REFRESH_AGGREGATES_ONCE=false

# ---------------------------------------------------------------------------
# CWE taxonomy catalog (MITRE reference data: labels for the CWE ids that CVE
# and KEV rows already carry). Acquired by the worker, served only from SQLite.
# ---------------------------------------------------------------------------
# Optional. Source url of the pinned MITRE CWE view pack (`CSV.zip`). Must be an
# absolute https URL; blank uses the default, the "Research Concepts" view
# (https://cwe.mitre.org/data/csv/1000.csv.zip). Overrides exist for controlled
# mirrors and tests, not for routine operation.
CWE_CSV_URL=

# Optional. Allowed values: true | false. Default true.
#   true: the worker refreshes the CWE catalog at most once per 24h. The refresh
#         is one conditional HTTPS request (the pack is compared by SHA-256 and
#         skipped when unchanged) and is fail-soft: a failure marks the catalog
#         stale, keeps the previous entries, and never fails an ingest cycle.
#   false: the catalog is only refreshed by the one-off command below.
CWE_REFRESH_ENABLED=true

# One-off CWE catalog refresh (no import cycle). Allowed values: true | false.
#   true: `node dist/worker.mjs` performs exactly one fetch/parse/publish of the
#         pinned pack, logs cwe-refresh / cwe-refresh-unchanged /
#         cwe-refresh-failed, and exits (non-zero if the attempt failed).
#           REFRESH_CWE_ONCE=true node dist/worker.mjs
#         Use it to seed a volume, or to retry a catalog a failed refresh left
#         stale.
#   false (default): normal worker boot behavior.
REFRESH_CWE_ONCE=false

# ---------------------------------------------------------------------------
# One-off verified backup (`RUN_BACKUP_ONCE=true BACKUP_DIR=... node worker.mjs`,
# or scripts/nightly-backup.sh for the scheduled host cron).
# ---------------------------------------------------------------------------
# Optional. Allowed values: true | false. Default false (normal worker boot).
#   true: writes a hash-verified backup image + manifest into BACKUP_DIR and
#         exits (no import cycle, no scheduler). BACKUP_DIR is required.
RUN_BACKUP_ONCE=false
# Optional. Destination directory for the one-off backup (created if absent).
# Unset/blank refuses with backup-dir-missing instead of writing anywhere.
BACKUP_DIR=

# ---------------------------------------------------------------------------
# One-off CVSS backfill script (`npm run backfill:cvss`)
# ---------------------------------------------------------------------------
# Explicit database path; overrides DATA_DIR when set.
CVE_DB_FILE=
# Rows per transaction.
BACKFILL_CHUNK=2000
# Explicit better-sqlite3 package path when running the script outside the
# container. Leave blank to use the normal module resolution.
BETTER_SQLITE3_PATH=
