# =============================================================================
# .env.example — committed template for environment configuration.
#
# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` and all `.env.*` files are gitignored. This file is the only one that
# is committed, and it must never contain real secrets.
#
# Rules:
#   1. Every environment variable the application reads MUST be listed here,
#      with a placeholder value and a short description comment.
#   2. Use obvious placeholders (changeme, localhost, example.test) — never
#      real credentials, tokens, keys, or personal data.
#   3. When a variable is added or renamed, update this file in the same change
#      and note it in the task's wrap-up.
# =============================================================================

# Runtime environment. Allowed values: development | staging | production.
# Missing or unknown values must fail closed to production-safe defaults.
APP_ENV=development

# -----------------------------------------------------------------------------
# Add future variables below, one per line, each with a description, e.g.:
# DATABASE_URL=postgres://app:changeme@localhost:5432/app   # local dev database
# LOG_LEVEL=debug                                           # development only
# -----------------------------------------------------------------------------
