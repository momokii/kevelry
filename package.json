{
  "name": "cve-change-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Public CVE overview with explainable prioritization and Change Radar. App shell only, no app behavior yet.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --outfile=dist/worker.mjs && mkdir -p dist/migrations && cp src/lib/migrations/*.sql dist/migrations/",
    "start": "next start",
    "lint": "eslint . --ignore-pattern 'dist/**'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:cvss": "node scripts/backfill-cvss.mjs",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@visx/annotation": "^4.0.0",
    "@visx/axis": "^4.0.0",
    "@visx/brush": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
